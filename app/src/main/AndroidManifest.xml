<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Phase 1: permissions sirf declare ki gayi hain.
         Setup wizard ek-ek karke, wajah ke saath maangega (D11). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!-- 0.2.2: App Groups ke liye SAARI installed apps ki list chahiye.
         Android 11+ package-visibility ke kaaran iske bina
         getInstalledApplications aadhi list deta hai — wahi bug tha. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 0.2.5: INTERNET sirf "AI se Workflow banwao" (Gemini) ke liye hai —
         user ke "Banwao" dabane par hi, uski apni API key se, network
         chalta hai. Baaki poora app hamesha ki tarah offline hai. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 0.2.6: set_volume action ke liye — AudioManager se media
         volume badalne ki ijaazat (koi khaas grant nahi chahiye). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 0.2.6: set_brightness action ke liye — yeh SYSTEM-LEVEL grant
         hai; declare karna zaroori hai, asal ijaazat user Setup Wizard
         se "Modify system settings" wali screen par deta hai. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- 0.2.8: Intruder Alert ka photo capture — CAMERA ek runtime
         permission hai (Setup Wizard ka step 11); FOREGROUND_SERVICE_CAMERA
         + service type "camera" targetSdk 34 ki shart hai taaki live
         foreground service camera istemal kar sake. uses-feature
         required=false: bina front camera wale phone par bhi app
         chalega (capture wahan imaandaari se skip + log hoga). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.front"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.WorkflowListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.WorkflowEditActivity"
            android:exported="false" />

        <!-- 0.2.5: Gemini se workflow banwane wali screen -->
        <activity
            android:name=".ui.AiWorkflowActivity"
            android:exported="false" />

        <!-- 0.2.8: System tab hub, Running Services aur Intruder Captures -->
        <activity
            android:name=".ui.SystemHubActivity"
            android:exported="false" />

        <activity
            android:name=".ui.RunningServicesActivity"
            android:exported="false" />

        <!-- 0.2.9: Backup / Restore (SAF export/import) -->
        <activity
            android:name=".ui.BackupRestoreActivity"
            android:exported="false" />

        <activity
            android:name=".ui.CapturesActivity"
            android:exported="false" />

        <activity
            android:name=".setup.SetupWizardActivity"
            android:exported="false" />

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false" />

        <!-- 2.1: Logs/Console aur App Picker -->
        <activity
            android:name=".ui.LogsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.AppPickerActivity"
            android:exported="false" />

        <!-- D7: Popup bot type — dialog-style window, overlay nahi -->
        <activity
            android:name=".ui.PopupActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Material.Dialog" />

        <!-- Notification buttons yahan aate hain — invisible, turant finish.
             0.2.7: theme Theme.NoDisplay se BADLA gaya — NoDisplay ki
             shart hai ki activity onResume() se pehle finish() ho,
             warna framework use IllegalStateException se gira deta
             hai. Delete-confirm wala raasta result ke intezaar me
             zinda rehta tha, isliye app thik consent khulne ke pal
             par crash hoti thi (consent window system process se
             pehle hi nikal chuki hoti thi). Translucent.NoTitleBar +
             koi content view nahi = ab bhi poori invisible, par
             zinda rehna kanooni hai. -->
        <activity
            android:name=".ui.TrampolineActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".service.CareService"
            android:exported="false"
            android:foregroundServiceType="specialUse|camera">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Caretaker notification workflows ke liye hamesha-on care service" />
        </service>

        <!-- Phase 2: ASLI accessibility service — isi se "My Care"
             Settings > Accessibility > Installed services me dikhega.
             (Phase 1 me yeh ghoshna hi nahi thi — wahi defect tha.) -->
        <service
            android:name=".service.CareAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 0.2.6: notification_posted trigger ki jaan — doosre apps ki
             notifications SUNNE wali service. System-level grant
             (Notification Access) user Setup Wizard se deta hai; grant
             na ho to system isse kabhi jodta hi nahi (inert rehti hai).
             Service sirf matching workflow FIRE karti hai — kisi
             notification ka text store nahi hota. -->
        <service
            android:name=".service.CareNotificationListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receiver.DailyAlarmReceiver"
            android:exported="false" />

        <!-- Phase 3: screenshot auto-delete ka scheduled receiver -->
        <receiver
            android:name=".receiver.DeleteReceiver"
            android:exported="false" />

        <!-- Phase 3: battery-full jaise one-shot alarm notifications -->
        <receiver
            android:name=".receiver.AlarmNotifyReceiver"
            android:exported="false" />

        <receiver
            android:name=".receiver.CareDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="false">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
