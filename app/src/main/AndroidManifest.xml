<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Phase 1: permissions sirf declare ki gayi hain.
         Setup wizard ek-ek karke, wajah ke saath maangega (D11). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!-- 0.2.2: App Groups ke liye SAARI installed apps ki list chahiye.
         Android 11+ package-visibility ke kaaran iske bina
         getInstalledApplications aadhi list deta hai — wahi bug tha. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 0.2.5: INTERNET sirf "AI se Workflow banwao" (Gemini) ke liye hai —
         user ke "Banwao" dabane par hi, uski apni API key se, network
         chalta hai. Baaki poora app hamesha ki tarah offline hai. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.WorkflowListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.WorkflowEditActivity"
            android:exported="false" />

        <!-- 0.2.5: Gemini se workflow banwane wali screen -->
        <activity
            android:name=".ui.AiWorkflowActivity"
            android:exported="false" />

        <activity
            android:name=".setup.SetupWizardActivity"
            android:exported="false" />

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false" />

        <!-- 2.1: Logs/Console aur App Picker -->
        <activity
            android:name=".ui.LogsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.AppPickerActivity"
            android:exported="false" />

        <!-- D7: Popup bot type — dialog-style window, overlay nahi -->
        <activity
            android:name=".ui.PopupActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Material.Dialog" />

        <!-- Notification buttons yahan aate hain — invisible, turant finish -->
        <activity
            android:name=".ui.TrampolineActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <service
            android:name=".service.CareService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Caretaker notification workflows ke liye hamesha-on care service" />
        </service>

        <!-- Phase 2: ASLI accessibility service — isi se "My Care"
             Settings > Accessibility > Installed services me dikhega.
             (Phase 1 me yeh ghoshna hi nahi thi — wahi defect tha.) -->
        <service
            android:name=".service.CareAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receiver.DailyAlarmReceiver"
            android:exported="false" />

        <!-- Phase 3: screenshot auto-delete ka scheduled receiver -->
        <receiver
            android:name=".receiver.DeleteReceiver"
            android:exported="false" />

        <!-- Phase 3: battery-full jaise one-shot alarm notifications -->
        <receiver
            android:name=".receiver.AlarmNotifyReceiver"
            android:exported="false" />

        <receiver
            android:name=".receiver.CareDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="false">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
